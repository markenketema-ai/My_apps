*{box-sizing:border-box}body{margin:0;background:#f4f7fb;color:#172a45;font:14px Inter,system-ui,Arial}.layout{display:flex;min-height:100vh}aside{width:245px;background:#071b36;color:#fff;padding:22px 15px;display:flex;flex-direction:column;flex-shrink:0}.brand{display:flex;gap:12px;align-items:center;padding:0 12px 30px}.mark,.login-logo{background:linear-gradient(135deg,#18c989,#087be5);border-radius:12px;width:43px;height:43px;display:grid;place-items:center;font-size:25px;font-weight:900}.brand b{font-size:21px;letter-spacing:2px}.brand small{display:block;color:#4cddb0;font-size:9px;letter-spacing:1px}nav{display:grid;gap:7px}nav button{padding:13px;border:0;background:none;color:#b9c8db;text-align:left;border-radius:9px;cursor:pointer}nav button.active,nav button:hover{background:#153958;color:#fff}.profile{margin-top:auto;border-top:1px solid #25415f;padding:20px 8px 0}.profile button{float:right;background:#25415f;color:#fff;border:0;padding:5px 8px;border-radius:6px}main{flex:1;min-width:0;padding:25px}header{display:flex;align-items:center;gap:14px;margin-bottom:25px}header h1{font-size:24px;margin:0 0 5px}header small,.muted{color:#8290a3}.online{margin-left:auto;color:#078b60;background:#e3f8ee;border-radius:20px;padding:8px 12px;font-size:12px}.primary{background:#087be5;color:#fff;border:0;border-radius:9px;padding:12px 16px;font-weight:700;cursor:pointer}.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:15px}.card{background:#fff;border:1px solid #e6edf5;border-radius:14px;padding:19px;box-shadow:0 5px 18px #102b4b05}.label{color:#8391a4;font-size:12px}.value{font-size:24px;font-weight:800;margin:10px 0}.green{color:#0b9b68}.two{display:grid;grid-template-columns:1.4fr 1fr;gap:16px;margin-top:18px}.title{font-weight:750;margin-bottom:15px}.bar{height:9px;background:#edf2f8;border-radius:20px;margin:12px 0 20px}.bar span{display:block;height:100%;background:linear-gradient(90deg,#17c68b,#087be5);border-radius:20px}.tablebox{background:#fff;border-radius:14px;padding:18px;margin-top:18px;overflow:auto}table{width:100%;border-collapse:collapse}th,td{text-align:left;padding:13px 10px;border-bottom:1px solid #edf1f6;white-space:nowrap}th{color:#8492a5;font-size:12px;font-weight:500}.status{background:#e5f8ee;color:#078d5f;padding:5px 9px;border-radius:20px;font-size:11px}.pending{background:#fff3dc;color:#a66b00}.tools{display:flex;gap:10px;justify-content:space-between;align-items:center;margin-bottom:15px}.tools input,input{padding:11px;border:1px solid #dfe7f0;border-radius:9px;outline-color:#087be5}.loginbox{max-width:420px;margin:8vh auto;background:#fff;padding:30px;border-radius:18px;text-align:center;box-shadow:0 15px 45px #12294b12}.login-logo{margin:auto}.loginbox form{display:grid;gap:12px;margin-top:20px}.loginbox a{color:#087be5;cursor:pointer}.loginbox[hidden],section[hidden],form[hidden]{display:none!important}#toggle{border:0;background:#fff;padding:10px;border-radius:8px}footer{padding:25px;text-align:center;color:#9aa7b8}@media(max-width:900px){.cards{grid-template-columns:repeat(2,1fr)}.two{grid-template-columns:1fr}}@media(max-width:650px){aside{position:fixed;z-index:4;left:-250px;top:0;bottom:0;transition:.2s}aside.open{left:0}main{padding:16px 12px}header h1{font-size:20px}.cards{gap:9px}.card{padding:13px}.value{font-size:19px}.online{display:none}.tools{flex-wrap:wrap}.tools input{width:100%}}
